# Copy this file to backend/.env and replace every placeholder.
APP_ENV=development
COOKIE_SECURE=false
FRONTEND_URL=http://127.0.0.1:5500
AUTH_DB_PATH=./code_intelligence.db

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# GitHub OAuth (local callback must exactly match GitHub OAuth App settings)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email repo

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:8000/api/auth/google/callback

# AI providers (at least one valid key is required for AI features)
GEMINI_API_KEY=
GROQ_API_KEY=
AI_FALLBACK_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash
GROQ_REVIEW_MODEL=openai/gpt-oss-120b
